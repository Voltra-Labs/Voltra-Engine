#![enable(implicit_some)]
// The engine's light UI theme, the dark one's swap: dark text on pale
// controls. See `dark.theme.ron` for the sections.
(
    version: 1,
    font: "fonts/Ubuntu-Light.ttf",
    text_color: (0.08, 0.09, 0.12, 1.0),
    button: (
        normal: (0.82, 0.84, 0.88, 1.0),
        hovered: (0.9, 0.92, 0.96, 1.0),
        pressed: (0.7, 0.72, 0.78, 1.0),
        disabled: (0.75, 0.75, 0.75, 0.5),
    ),
    selected_tint: (0.7, 1.0, 0.75, 1.0),
    panel: (color: (0.95, 0.95, 0.97, 0.98)),
    field: (color: (1.0, 1.0, 1.0, 1.0), selection: (0.55, 0.7, 1.0, 0.6)),
    slider: (
        track: (0.78, 0.8, 0.85, 1.0),
        fill: (0.35, 0.55, 0.95, 1.0),
        handle: (0.25, 0.3, 0.45, 1.0),
    ),
    dropdown: (background: (0.97, 0.97, 0.99, 0.99), highlight: (0.55, 0.7, 1.0, 1.0)),
    tooltip: (background: (1.0, 1.0, 0.92, 0.97), color: (0.08, 0.09, 0.12, 1.0), size: 14.0),
)
