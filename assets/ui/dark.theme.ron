#![enable(implicit_some)]
// The engine's dark UI theme: what `tick.set_theme("ui/dark.theme.ron")`
// gives every control that keeps no style of its own. Every section is
// optional; a `skin: (texture: "ui/x.png", borders: (left: 6.0, top: 6.0,
// right: 6.0, bottom: 6.0))` in a button, panel or field section draws it
// as a 9-slice.
(
    version: 1,
    font: "fonts/Ubuntu-Light.ttf",
    text_color: (0.94, 0.95, 1.0, 1.0),
    button: (
        normal: (0.2, 0.22, 0.28, 1.0),
        hovered: (0.3, 0.34, 0.44, 1.0),
        pressed: (0.14, 0.15, 0.2, 1.0),
        disabled: (0.2, 0.2, 0.2, 0.5),
    ),
    selected_tint: (0.45, 1.0, 0.55, 1.0),
    panel: (color: (0.06, 0.07, 0.1, 0.96)),
    field: (color: (0.08, 0.09, 0.12, 1.0), selection: (0.25, 0.45, 0.9, 0.6)),
    slider: (
        track: (0.12, 0.13, 0.17, 1.0),
        fill: (0.3, 0.5, 0.9, 1.0),
        handle: (0.75, 0.8, 0.95, 1.0),
    ),
    dropdown: (background: (0.1, 0.11, 0.15, 0.98), highlight: (0.25, 0.45, 0.9, 1.0)),
    tooltip: (background: (0.02, 0.02, 0.04, 0.94), color: (1.0, 1.0, 1.0, 1.0), size: 14.0),
)
