// The character example's state machine. The game sets `speed` (how fast
// it walks), `grounded` and `rising` (its upward speed) every step. On the
// ground it is in `move`, a blend tree: idle, walk and run mixed by
// `speed`, synced so the bob keeps its phase as it speeds up. Every
// transition crossfades (`duration`, seconds): leaving the ground quickly,
// landing more slowly.
(
    parameters: [
        (name: "speed", value: Float(0.0)),
        (name: "rising", value: Float(0.0)),
        (name: "grounded", value: Bool(true)),
    ],
    start: "move",
    states: [
        (name: "move", tree: Blend1D(parameter: "speed", children: [
            (threshold: 0.0, clip: Path("animations/hero/idle.anim.ron")),
            (threshold: 1.5, clip: Path("animations/hero/walk.anim.ron")),
            (threshold: 3.5, clip: Path("animations/hero/run.anim.ron")),
        ])),
        (name: "jump", clip: Path("animations/hero/jump.anim.ron")),
        (name: "fall", clip: Path("animations/hero/fall.anim.ron")),
    ],
    transitions: [
        (to: "jump", conditions: [IfNot("grounded"), Greater("rising", 0.5)], duration: 0.05),
        (to: "fall", conditions: [IfNot("grounded"), Less("rising", -0.5)], duration: 0.1),
        (to: "move", conditions: [If("grounded")], duration: 0.15),
    ],
)
